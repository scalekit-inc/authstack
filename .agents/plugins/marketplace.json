{
  "name": "scalekit-authstack",
  "interface": {
    "displayName": "Scalekit AuthStack"
  },
  "plugins": [
    {
      "name": "agentkit",
      "source": {
        "source": "local",
        "path": "./kits/agentkit"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Authentication"
    },
    {
      "name": "saaskit",
      "source": {
        "source": "local",
        "path": "./kits/saaskit"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Authentication"
    }
  ]
}
